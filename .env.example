# Copy to .env and fill in. Never commit .env.

# PostgreSQL (development: local Docker container)
ELO_DB_HOST=
ELO_DB_PORT=
ELO_DB_NAME=
ELO_DB_USER=
ELO_DB_PASS=

# Secrets (server only; optional in development)
# Salt for hashing account names. Anything that hashes account names refuses to run without it.
ELO_ACCOUNT_HASH_SALT=
# Discord webhook for admin alerts. When empty, alerts are only logged.
ELO_DISCORD_WEBHOOK_URL=

# User-Agent contact details (not decided yet; see docs/decisions.md)
ELO_CONTACT_EMAIL=
ELO_PROJECT_URL=

# Logging
ELO_LOG_LEVEL=INFO
